{
  "name": "hlxll-electron",
  "version": "1.0.0",
  "private": true,
  "description": "A desktop application built with Electron",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:mac": "npm run rebuild && electron-builder --mac",
    "build:win": "npm run rebuild && electron-builder --win",
    "build:nsis": "npm run rebuild && electron-builder --nsis",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js"
  },
  "build": {
    "appId": "com.example.myapp",
    "productName": "MyApp",
    "publish": [
      {
        "provider": "github",
        "owner": "hlxll",
        "repo": "electronMoreSystem"
      }
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      "public/AppIcon.icns",
      "src/child-server.js",
      "config.json"
    ],
    "mac": {
      "icon": "./public/pardox.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11"
  }
}
